{
  "name": "ViewFinder Localhost",
  "description": "Find out how different news outlets report about the same event. Requires access to Google News stories.",
  "version": "0.1.7",
  "manifest_version": 3,
  "action": {
    "default_popup": "assets/html/settings.html",
    "default_title": "ViewFinder Settings",
    "default_icon": {
      "16": "assets/images/icon-16.png",
      "32": "assets/images/icon-32.png",
      "48": "assets/images/icon-48.png",
      "128": "assets/images/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/images/icon-16.png",
    "32": "assets/images/icon-32.png",
    "48": "assets/images/icon-48.png",
    "128": "assets/images/icon-128.png"
  },
  "side_panel": {
    "default_path": "assets/html/sidepanel.html"
  },
  "host_permissions": [
    "https://news.google.com/stories/*",
    "file:///Users/rupsharray/Desktop/ICDM%20Local/*",
    "http://localhost:5000/*",
    "https://fonts.googleapis.com/*"
  ], 
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "sidePanel", "tabs", "storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' http://localhost:5000/;"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/html/overlay.html", "assets/css/overlay.css", "content.js"],
      "matches": ["https://news.google.com/*", "file:///*", "https://fonts.googleapis.com/*"],
      "use_dynamic_url": false
    }
  ]
}