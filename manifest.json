{
  "name": "ViewFinder",
  "description": "Find out how different news outlets report about the same event. Requires access to Google News stories.",
  "version": "0.1.1",
  "manifest_version": 3,
  "action": {
    "default_title": "Click to Activate",
    "default_icon": {
      "16": "assets/images/icon-16.png",
      "32": "assets/images/icon-32.png",
      "48": "assets/images/icon-48.png",
      "128": "assets/images/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/images/icon-16.png",
    "32": "assets/images/icon-32.png",
    "48": "assets/images/icon-48.png",
    "128": "assets/images/icon-128.png"
  },
  "side_panel": {
    "default_path": "assets/html/sidepanel.html"
  },
  "host_permissions": [
    "https://news.google.com/stories/*",
    "http://127.0.0.1:5000/*" 
  ], 
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "sidePanel", "tabs"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' http://127.0.0.1:5000;"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/html/overlay.html", "assets/css/overlay.css"],
      "matches": ["https://news.google.com/*"],
      "use_dynamic_url": false
    }
  ]
}